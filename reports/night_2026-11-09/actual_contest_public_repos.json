  "hypotheses": [
    {
      "id": "H1",
      "idea": "Measure a small cost model including visible files/source size, not just question length; compare to our type medians before considering a new controller.",
      "why": "Kozlov's linear+EMA is a simple baseline; safe_priority already supplies measured per-type priors.",
      "validation": "Old development groups only, equal global budgets, reward plus known cost, no unknown=0 labels. No fresh32/64 exposure."
    },
    {
      "id": "H2",
      "idea": "Keep the README contract and all named APIs in reduced coding context; preserve fresh file cache after edits.",
      "why": "Test-centered excerpts can hide untested requirements. Our safe cache is already stronger than cached initial prefixes.",
      "validation": "Public requirement-coverage fixtures and previously inspected difficult cases; no private-derived routing or new prompts specific to hidden cases."
    },
    {
      "id": "H3",
      "idea": "Separate predicted remaining cost from a hard accounting bound, and distinguish known usage from held/uncertain reservations.",
      "why": "Public repositories have materially different failure paths; copied release-on-exception would undo our budget guarantees.",
      "validation": "Existing offline transport/reservation fixtures, not model generation."
    },
    {
      "id": "H4",
      "idea": "Evaluate optional checks by incremental reward per cost, with a no-check baseline and allowance for harm.",
      "why": "AlfaGraph's explicit fix/harm/cost decomposition is useful, but9positive examples and one self-reported100 are weak evidence for transfer.",
      "validation": "Repeated frozen equal-budget development comparisons; preserve completed candidates; no learned review layer until a simple policy wins."
    },
    {
      "id": "H5",
      "idea": "Require real test execution and contract checks before treating publicPASS as useful evidence.",
      "why": "Two public harnesses use script exit0; our testsRun>0 and strict pass conditions should remain. Safe_review changes the stop condition, not the truth of a check.",
      "validation": "Our fixed unittest-without-main, failed-assert, explicit-DONE and candidate-preservation fixtures."
    }
