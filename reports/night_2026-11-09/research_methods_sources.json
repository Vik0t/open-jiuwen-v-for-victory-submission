  "findings": {
    "TokenEconomizer": [
      "Strict stuck fallback combines edits, sustained errors and repeated failure signatures; it does not directly detect our successful repeated read calls.",
      "Default 18/20-call gates do not transfer unchanged to an 8-step controller.",
      "TurnGuard.resolved_proxy is not an external quality verdict.",
      "Optional judge and redirect writer are paid calls; pricing fallback is not our hard usage ledger.",
      "Micro-skill promotion and retirement are repository-history dependent."
    ],
    "BATS": [
      "Budget Tracker inserts tool-specific used/remaining counts; the selected driver also has a paid finalization call.",
      "BATS verify_answer makes an additional model call and adds its token counts; configured continuation can reset a trajectory.",
      "Prompts assume an answer exists; our contest permits genuinely unsolvable tasks.",
      "Tool request truncation does not implement per-request token reservation."
    ],
    "CodeRescue": [
      "Published paper name and README ARCHER name differ at the pinned commit.",
      "agents/code_agent.py at repository root is 404; actual path is data_generation/agents/code_agent.py.",
      "Selected calibration script replays pre-collected costs_usd; it does not run a live agent.",
      "Selected script uses Hoeffding epsilon and cost range from calibration plus test, unlike the paper's displayed conformal correction.",
      "Paper expectation/marginal guarantees do not imply a hard per-run budget cap.",
      "Short-circuit collection does not observe every action on every task; missing outcomes cannot be treated as success or failure.",
      "The collector calls cold-start escalate; escalate_with_context exists separately.",
      "CodeAgent has internal parse retries and higher model output caps; do not transplant its accounting defaults."
    ],
    "SWEPatchTest": [
      "Fail-to-pass on one reference patch does not guarantee rejection of wrong patches or acceptance of alternative correct patches.",
      "No benchmark code or candidate pools were executed or audited here."
    ]
